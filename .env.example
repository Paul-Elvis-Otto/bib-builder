# Local web server
BIB_HOST=127.0.0.1
BIB_PORT=8000

# Ollama-compatible server and exact installed model name
OLLAMA_HOST=http://127.0.0.1:11434
BIB_MODEL=qwen3.8:27b-mlx

# Optional Gemini review: leave the key empty to keep it disabled.
# Search grounding may require billing; see README.md.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Mistral app: uv run python mistral.py
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-4-1
MISTRAL_CHAT_MODEL=mistral-small-latest
# OpenAlex API key required for authenticated citation matching
OPENALEX_API_KEY=
BIB_DATABASE=papers.sqlite3
